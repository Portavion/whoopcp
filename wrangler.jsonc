{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Replace id, preview_id, and WHOOP_REDIRECT_URI before deploying on any other Cloudflare account.
  // The committed values are the original author's and will fail or send OAuth to the wrong host.
  "name": "whoopcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "WHOOP_TOKENS",
      "id": "c528748f64574c03aff099ff0b92a1e6",
      "preview_id": "8029d3df24714ced900dcb96de0b4033"
    }
  ],
  "vars": {
    "WHOOP_REDIRECT_URI": "https://whoop.portalier.org/whoop/callback"
  },
  "triggers": {
    "crons": ["0,45 * * * *"]
  }
}
